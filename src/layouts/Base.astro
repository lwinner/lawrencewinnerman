---
// Base layout: meta tags, Open Graph, structured data, favicons, fonts. The tags are HeadTags.astro's, which a page in
// Heliostet's frame draws too (src/lw/Head.astro).
import HeadTags from "./HeadTags.astro";
export type { Props } from "./HeadTags.astro";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <HeadTags {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
