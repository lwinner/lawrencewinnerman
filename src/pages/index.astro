---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Bio from "../components/Bio.astro";
import PullQuote from "../components/PullQuote.astro";
import Work from "../components/Work.astro";
import Consulting from "../components/Consulting.astro";
import FeaturedStories from "../components/FeaturedStories.astro";
import RecentStories from "../components/RecentStories.astro";
import Subscribe from "../components/Subscribe.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { homeGraph } from "../data/site-schema";
---
<Base ogImage="/og/og-home-1280x720.png" graph={homeGraph}>
  <Nav />
  <Hero />
  <main>
    <FeaturedStories />
    <Work />
    <RecentStories />
    <Consulting />
    <Bio />
    <PullQuote />
    <Subscribe />
    <Contact />
  </main>
  <Footer />
</Base>
