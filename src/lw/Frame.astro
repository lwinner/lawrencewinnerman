---
// lawrencewinnerman.com's own frame (relay entry 127, decision 0019): Heliostet draws each page from its page file
// in site/ and asks the site to draw the page around it, exactly as before the move. This is the Base layout, the nav,
// and the footer every page had, with the head each page passed (its title, description, and structured data), chosen
// by the page file's frameOptions.head. Its look is today's (Fork 7); nothing here changes what a reader sees. The
// home page's sections, the Hero first, are its page file's parts, each drawn by its component as before.
import type { OwnFrameProps } from "@vellumandvolt/heliostet/parts";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HeadExtras from "./HeadExtras.astro";
import { headFor } from "./heads";

const { page } = Astro.props as OwnFrameProps;
// The head each page passes Base (heads.ts), the same one src/lw/Head.astro draws in Heliostet's frame.
const { props, writing, keys, story } = headFor(page, Astro.site!);
---
<Base {...props}>
  {/* What Heliostet puts in the head for a page of its parts (their stylesheet), passed on to Base's head. */}
  <slot name="head" slot="head" />
  <Fragment slot="head"><HeadExtras writing={writing} keys={keys} story={story} /></Fragment>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />
</Base>
