---
// Featured stories (#featured). Hand-pinned pieces that live off the Hinge &
// Near Field feed (Medium, The Daily Whatever Show), shown right under the
// hero so visitors arriving from a social bio link see the newest work first.
// Edit src/content/featured.json to pin entries; the newest catalog stories
// fill the rest of the six slots. Card styles mirror RecentStories.astro.
import featured from "../content/featured.json";
import { localPathFor, stories as catalog, storyPath, shortDate } from "../lib/stories";

// Always a six-up: hand-pinned entries from featured.json first, then the
// newest catalog stories that aren't pinned and don't live on The Hinge &
// The Near Field (Recent stories already shows that feed).
const SLOTS = 6;
const pinned = (featured.stories ?? []).map((s) => {
  const local = localPathFor(s.link);
  return { ...s, href: local ?? s.link, external: !local };
});
const taken = new Set(pinned.map((s) => s.href));
const fill = catalog
  .filter((c) => !taken.has(storyPath(c)))
  .filter((c) => !c.links.some((l) => l.url.includes("lwinner.substack.com")))
  .slice(0, Math.max(0, SLOTS - pinned.length))
  .map((c) => ({
    title: c.title,
    href: storyPath(c),
    external: false,
    date: shortDate(c.date),
    outlet: c.links[0]?.label,
    excerpt: c.dek,
    image: c.image,
  }));
const stories = [...pinned, ...fill].slice(0, SLOTS);
---
{stories.length > 0 && (
  <section id="featured" class="featured" aria-label="Featured stories">
    <div class="container">
      <p class="eyebrow">New</p>
      <h2>Just published.</h2>
      <div class="story-grid" role="list">
        {stories.map(s => (
          <a class="story" href={s.href} rel={s.external ? "noopener" : undefined} target={s.external ? "_blank" : undefined} role="listitem">
            <div class="story-media">
              {s.image && (
                <img src={s.image} alt="" loading="eager" width="640" height="360" />
              )}
            </div>
            <div class="story-body">
              <p class="story-date">{s.date}{s.outlet && <span class="story-outlet"> &middot; {s.outlet}</span>}</p>
              <h3 class="story-title">{s.title}</h3>
              {s.excerpt && <p class="story-excerpt">{s.excerpt}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .featured h2 { margin: 0 0 2.5rem; }
  .featured .eyebrow { margin-bottom: 1.25rem; }
  .featured .story-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 960px) { .featured .story-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .featured .story-grid { grid-template-columns: 1fr; } }
  .featured .story-date { white-space: normal; }
  .story-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
  }
  .story {
    display: flex;
    flex-direction: column;
    background: var(--lw-cream-card);
    border: 1px solid var(--lw-rule);
    border-radius: 6px;
    overflow: hidden;
    color: var(--lw-slate);
    transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .story:hover {
    color: var(--lw-slate);
    transform: translateY(-2px);
    box-shadow: 0 1px 2px rgba(67, 74, 82, 0.08);
  }
  .story-media {
    aspect-ratio: 16 / 9;
    background: var(--lw-rule);
    overflow: hidden;
  }
  .story-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .story-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.25rem 1.5rem;
    flex: 1;
  }
  .story-date {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
    white-space: nowrap;
  }
  .story-title {
    font-family: var(--font-subhead);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.15;
    margin: 0;
    color: var(--lw-slate);
  }
  .story-excerpt {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--lw-slate-soft);
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .story { transition: none; }
    .story:hover { transform: none; }
  }
</style>
