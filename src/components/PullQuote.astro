---
// Pull quote — Margaret Mead, centered, between Bio and Work.
// Its words are the part's fields (src/lw/words.ts), so what the Cockpit edits is what the site shows.
// The text is the quote, a blank line, and who said it.
import { em, textOf } from "../lw/words";
const { fields = {} } = Astro.props;
const lines = textOf(fields.body).split(/\n\s*\n/).map((l) => l.trim()).filter(Boolean);
const who = lines.length > 1 ? lines.pop() : "";
---
<aside class="pullquote" aria-label="Pull quote">
  <div class="container">
    <hr class="rule-red" aria-hidden="true" />
    <blockquote set:html={em(lines.join(" "))} />
    {who && <p class="attribution" set:html={em(who)} />}
  </div>
</aside>

<style>
  .pullquote {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
  }
  .pullquote .container { text-align: center; }
  .pullquote .rule-red { margin: 0 auto 1.75rem; }
  .pullquote blockquote {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    line-height: 1.25;
    color: var(--lw-slate);
    max-width: 30ch;
    margin: 0 auto;
  }
  .attribution {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 1.5rem 0 0;
  }
</style>
