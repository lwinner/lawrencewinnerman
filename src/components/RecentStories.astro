---
// Recent stories (#writing). Two layers:
//   1. BUILD time — scripts/fetch-recent.mjs writes src/data/recent.json, which
//      renders the cards below. Correct first paint, works with JS off.
//   2. LOAD time — the <script> at the bottom asks /api/recent (a Cloudflare
//      Pages Function, functions/api/recent.js) for the live top four and swaps
//      them in if they differ. New posts appear within ~10 minutes of
//      publishing, with no redeploy. Cards are cloned from the <template> so
//      Astro's scoped styles apply to client-built markup too.
import recent from "../data/recent.json";
import { localPathFor, pathByUrlKey } from "../lib/stories";

const ARCHIVE = "https://lwinner.substack.com/archive";
// Cards open the story's page on this site when one exists, else the Substack post.
const stories = (recent.ok ? recent.stories : []).map((s) => {
  const local = localPathFor(s.link);
  return { ...s, href: local ?? s.link, external: !local };
});
const feedFailed = !recent.ok || stories.length === 0;
---
<section id="writing" class="writing" aria-label="Recent stories" data-local={JSON.stringify(pathByUrlKey)}>
  <div class="container">
    <div class="writing-head">
      <div>
        <p class="eyebrow">The writing</p>
        <h2>Recent stories.</h2>
      </div>
      <div class="writing-links">
        <a class="writing-more" href="/writing/">
          All my writing <span aria-hidden="true">→</span>
        </a>
        <a class="writing-more" href={ARCHIVE} rel="noopener" target="_blank">
          Read the full Substack <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {feedFailed ? (
      <p class="writing-fallback">
        The latest essays are on Substack—<a href={ARCHIVE} rel="noopener" target="_blank">read the archive →</a>
      </p>
    ) : (
      <div class="story-grid" role="list">
        {stories.map(s => (
          <a class="story" href={s.href} rel={s.external ? "noopener" : undefined} target={s.external ? "_blank" : undefined} role="listitem">
            <div class="story-media">
              {s.image && (
                <img src={s.image} alt={s.title} loading="lazy" width="640" height="360" />
              )}
            </div>
            <div class="story-body">
              <p class="story-date">{s.date}</p>
              <h3 class="story-title">{s.title}</h3>
              {s.excerpt && <p class="story-excerpt">{s.excerpt}</p>}
            </div>
          </a>
        ))}
      </div>
    )}

    <template id="story-template">
      <a class="story" href="" rel="noopener" target="_blank" role="listitem">
        <div class="story-media"></div>
        <div class="story-body">
          <p class="story-date"></p>
          <h3 class="story-title"></h3>
          <p class="story-excerpt"></p>
        </div>
      </a>
    </template>
  </div>
</section>

<script>
  // Refresh the build-time cards with the live feed. Silent on any failure:
  // the build-time render is always a valid page on its own.
  const section = document.getElementById("writing");
  const tpl = document.getElementById("story-template") as HTMLTemplateElement | null;

  type Story = {
    id: string; title: string; link: string; date: string;
    excerpt: string; image: string | null;
  };

  // Map Substack/Medium URLs to this site's story pages (same keys as src/lib/stories.ts).
  let local: Record<string, string> = {};
  try { local = JSON.parse(section?.dataset.local || "{}"); } catch { /* none */ }
  function localPath(url: string): string | null {
    try {
      const u = new URL(url);
      const p = u.pathname.replace(/\/+$/, "");
      const m = u.hostname.endsWith("medium.com") ? p.match(/-([0-9a-f]{12})$/) : p.match(/\/p\/([^/]+)$/);
      if (!m) return null;
      return local[(u.hostname.endsWith("medium.com") ? "med:" : "sub:") + m[1]] ?? null;
    } catch { return null; }
  }

  function buildCard(s: Story): HTMLElement {
    const node = (tpl!.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    const lp = localPath(s.link);
    (node as HTMLAnchorElement).href = lp ?? s.link;
    if (lp) { node.removeAttribute("target"); node.removeAttribute("rel"); }
    if (s.image) {
      const img = document.createElement("img");
      img.src = s.image;
      img.alt = s.title;
      img.loading = "lazy";
      img.width = 640;
      img.height = 360;
      node.querySelector(".story-media")!.appendChild(img);
    }
    node.querySelector(".story-date")!.textContent = s.date;
    node.querySelector(".story-title")!.textContent = s.title;
    const ex = node.querySelector(".story-excerpt")!;
    if (s.excerpt) ex.textContent = s.excerpt; else ex.remove();
    return node;
  }

  async function refresh() {
    if (!section || !tpl) return;
    const res = await fetch("/api/recent", { headers: { accept: "application/json" } });
    if (!res.ok) return;
    const data = await res.json();
    if (!data || !data.ok || !Array.isArray(data.stories) || !data.stories.length) return;

    const current = Array.from(section.querySelectorAll<HTMLAnchorElement>(".story-grid .story"))
      .map((a) => a.href.replace(/[?#].*$/, ""));
    const incoming = (data.stories as Story[]).map((s) => {
      const lp = localPath(s.link);
      return lp ? new URL(lp, location.origin).href : s.link.replace(/[?#].*$/, "");
    });
    if (current.length === incoming.length && current.every((h, i) => h === incoming[i])) return;

    const grid = document.createElement("div");
    grid.className = "story-grid";
    grid.setAttribute("role", "list");
    // Copy Astro's scoping attribute so the grid itself picks up scoped CSS.
    for (const attr of Array.from(tpl.attributes)) {
      if (attr.name.startsWith("data-astro-cid")) grid.setAttribute(attr.name, attr.value);
    }
    for (const s of data.stories as Story[]) grid.appendChild(buildCard(s));

    const old = section.querySelector(".story-grid, .writing-fallback");
    if (old) old.replaceWith(grid); else tpl.before(grid);
  }

  refresh().catch(() => { /* keep build-time cards */ });
</script>

<style>
  .writing-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }
  .writing-head h2 { margin: 0; }
  .writing-head .eyebrow { margin-bottom: 1.25rem; }
  .writing-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; }
  .writing-more {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
    color: var(--lw-slate);
    white-space: nowrap;
    padding-bottom: 0.35rem;
  }
  .writing-more:hover { color: var(--lw-red); }

  .writing-fallback {
    font-style: italic;
    border-top: 1px solid var(--lw-rule);
    padding-top: 1.75rem;
    margin: 0;
  }
  .writing-fallback a { color: var(--lw-slate); text-decoration: underline; text-decoration-color: var(--lw-rule); text-underline-offset: 3px; }
  .writing-fallback a:hover { color: var(--lw-red); }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
  }
  .story {
    display: flex;
    flex-direction: column;
    background: var(--lw-cream-card);
    border: 1px solid var(--lw-rule);
    border-radius: 6px;
    overflow: hidden;
    color: var(--lw-slate);
    transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .story:hover {
    color: var(--lw-slate);
    transform: translateY(-2px);
    box-shadow: 0 1px 2px rgba(67, 74, 82, 0.08);
  }
  .story-media {
    aspect-ratio: 16 / 9;
    background: var(--lw-rule);
    overflow: hidden;
  }
  .story-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .story-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.25rem 1.5rem;
    flex: 1;
  }
  .story-date {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lw-muted);
    margin: 0;
    white-space: nowrap;
  }
  .story-title {
    font-family: var(--font-subhead);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.15;
    margin: 0;
    color: var(--lw-slate);
  }
  .story-excerpt {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--lw-slate-soft);
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .story { transition: none; }
    .story:hover { transform: none; }
  }
</style>
