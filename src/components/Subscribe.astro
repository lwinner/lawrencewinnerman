---
// Subscribe (#subscribe). Sits between Recent stories and Contact. A link out to The Hinge & The Near Field's own
// subscribe page on Substack: the site never collects an email address itself (ONB-1; Lawrence's ruling, relay
// entry 127, in place of the old Substack signup embed).
---
<section id="subscribe" class="subscribe">
  <div class="container">
    <div class="subscribe-card">
      <p class="eyebrow">Subscribe</p>
      <h2>Get the next one in your inbox.</h2>
      <p class="subscribe-lead">
        <strong><em>The Hinge &amp; The Near Field</em></strong>: essays, near-future scenarios, and fiction, delivered as they publish.
      </p>
      <p class="subscribe-action">
        <a class="btn" href="https://lwinner.substack.com/subscribe">Subscribe on Substack <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </div>
</section>

<style>
  .subscribe {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(4rem, 10vw, 7rem);
  }
  .subscribe-card {
    max-width: 680px;
    margin-inline: auto;
    background: var(--lw-cream-card);
    border: 1px solid var(--lw-rule);
    border-top: 3px solid var(--lw-red);
    border-radius: 6px;
    padding: clamp(2rem, 5vw, 3rem);
    text-align: center;
  }
  .subscribe-card .eyebrow { margin-bottom: 1.1rem; }
  .subscribe-card h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin: 0 0 0.75rem;
  }
  .subscribe-lead {
    font-style: italic;
    font-size: var(--fs-body);
    color: var(--lw-slate-soft);
    max-width: 44ch;
    margin: 0 auto 1.5rem;
  }
  .subscribe-action {
    margin: 0;
  }
</style>
