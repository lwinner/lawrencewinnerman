---
// About (#about): first person, from bio-library.md v1.1. Voice in the label,
// search words in the heading (workbook 7.3).
// Its words are the part's fields (src/lw/words.ts), so what the Cockpit edits is what the site shows.
import { em, paragraphs } from "../lw/words";
const { fields = {} } = Astro.props;
---
<section id="about" class="bio">
  <div class="container">
    {fields.eyebrow && <p class="eyebrow" set:html={em(fields.eyebrow)} />}
    <h2 set:html={em(fields.heading)} />
    <div class="bio-body" set:html={paragraphs(fields.body)} />
  </div>
</section>

<style>
  .bio-body {
    max-width: 62ch;
    font-size: var(--fs-body);
    line-height: 1.65;
  }
  .bio-body :global(p + p) { margin-top: 1rem; }
</style>
